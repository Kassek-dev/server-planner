{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!catalog/dist",
      "!design/canvas",
      "!**/*.dc.html",
      "!pnpm-lock.yaml",
      "!**/*.md",
      "!fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/model/**", "packages/engine/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "model/engine must not depend on React (CLAUDE.md invariant 1).",
                  "react-dom": "model/engine must not depend on the DOM.",
                  "idb": "model/engine must not depend on IndexedDB.",
                  "@server-planner/web": "model/engine must not import the app."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/model/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "model must not depend on React.",
                  "@server-planner/engine": "model must not import engine (dependency rule: engine \u2192 model)."
                }
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
